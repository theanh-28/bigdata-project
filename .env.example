# MongoDB endpoint used by Python scripts. Use mongodb://localhost:27017 for either mongod or mongos.
MONGO_URI=mongodb://localhost:27017
DB_NAME=yelp

# Single-node E1-E4 container settings. Change WT_CACHE_GB before recreating the container for E4.
MONGO_PORT=27017
WT_CACHE_GB=0.5
MONGO_MEMORY_LIMIT=1500m

# Sharded cluster: each shard container gets this memory limit; WiredTiger cache is set in Compose.
SHARD_MEMORY_LIMIT=1500m
